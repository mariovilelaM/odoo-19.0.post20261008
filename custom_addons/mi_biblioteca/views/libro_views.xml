<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. VISTA DE LISTA: qué columnas se ven en la lista de libros -->
    <record id="libro_view_list" model="ir.ui.view">
        <field name="name">biblioteca.libro.list</field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="autor"/>
                <field name="isbn"/>
                <field name="paginas"/>
                <field name="genero"/>
                <field name="disponible"/>
            </list>
        </field>
    </record>

    <!-- 2. VISTA DE FORMULARIO: la ficha de un libro -->
    <record id="libro_view_form" model="ir.ui.view">
        <field name="name">biblioteca.libro.form</field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="autor"/>
                        <field name="isbn"/>
                        <field name="fecha_publicacion"/>
                        <field name="paginas"/>
                        <field name="genero"/>
                        <field name="disponible"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. ACCIÓN: abrir los libros, primero en lista y luego en ficha -->
    <record id="libro_action" model="ir.actions.act_window">
        <field name="name">Libros</field>
        <field name="res_model">biblioteca.libro</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 4. MENÚS: el icono de la aplicación y su opción "Libros" -->
    <menuitem id="menu_biblioteca" name="Biblioteca"/>
    <menuitem id="menu_libros" name="Libros"
        parent="menu_biblioteca" action="libro_action"/>
</odoo>